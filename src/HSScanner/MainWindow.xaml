<Window x:Class="HSScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HSScanner"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HSScanner" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Read-only Laufwerksinventur für Lösch- und Aufbewahrungsplanung" Foreground="#DCE8F2" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="AUSGABE NUR NEBEN DER EXE" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="OutputFolderText" Foreground="#DCE8F2" FontSize="11" MaxWidth="520" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="18,16,18,10" Padding="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="1. Scan-Ziel" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DriveComboBox" Margin="0,0,10,0" SelectionChanged="DriveComboBox_SelectionChanged" />
                        <TextBox x:Name="SourcePathTextBox" Grid.Column="1" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2" Content="Ordner wählen…" Margin="10,0,0,0" Click="BrowseButton_Click" />
                    </Grid>
                    <TextBlock Grid.Row="2" Margin="0,9,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                               Text="Du kannst ein ganzes Laufwerk (z. B. L:\) oder einen einzelnen Stammordner scannen. HSScanner liest nur Metadaten; Quelldateien werden nicht verändert." />
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="2. Planungsfilter" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="Stichtag:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="CutoffYearsTextBox" Width="54" Text="11" TextAlignment="Center" VerticalContentAlignment="Center" />
                        <TextBlock Text="Jahre" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <CheckBox x:Name="IncludeHiddenCheckBox" IsChecked="True" Content="Versteckte Elemente einbeziehen" Margin="0,0,0,6" />
                        <CheckBox x:Name="IncludeSystemCheckBox" IsChecked="True" Content="Systemelemente einbeziehen" Margin="0,0,0,6" />
                        <CheckBox x:Name="SkipReparseCheckBox" IsChecked="True" Content="Reparse Points überspringen (empfohlen)" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                               Text="Der Stichtag markiert nur Prüfbedarf. Er ist keine rechtliche Löschentscheidung." />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="18,0,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Content="Scan starten" Click="ScanButton_Click" />
                <Button x:Name="CancelButton" Content="Abbrechen" IsEnabled="False" Click="CancelButton_Click" />
                <Button x:Name="ExportButton" Content="Excel exportieren" IsEnabled="False" Click="ExportButton_Click" />
            </StackPanel>
            <ProgressBar x:Name="ScanProgressBar" Grid.Column="1" Height="8" Margin="18,14,18,0" IsIndeterminate="False" VerticalAlignment="Top" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Ordner " Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="FolderCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="Dateien " Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="FileCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="Prüffälle " Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="OldFileCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="Fehler " Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="ErrorCountText" Text="0" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Margin="18,0,18,10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <TabControl BorderThickness="0" Background="Transparent">
                <TabItem Header="Übersicht">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="4" Margin="0,0,0,20">
                                <Border Margin="0,0,10,0" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                    <StackPanel><TextBlock Text="Ordner" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="SummaryFoldersText" Text="0" FontSize="26" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Margin="0,0,10,0" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                    <StackPanel><TextBlock Text="Dateien" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="SummaryFilesText" Text="0" FontSize="26" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Margin="0,0,10,0" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                    <StackPanel><TextBlock Text="Gesamtgröße" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="SummarySizeText" Text="0 B" FontSize="26" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                    <StackPanel><TextBlock Text="Älter als Stichtag" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="SummaryOldText" Text="0" FontSize="26" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Grid.Row="1" Padding="16" Background="#F7FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="Was der Excel-Export vorbereitet" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                               Text="Übersicht • Ordner mit Level 0/1/2/… und Parent-ID • direkte und rekursive Datei-/Größenwerte • Stichtagswerte • leere Felder für Verantwortliche, Entscheidung, Begründung, Freigabe, Löschdatum und Nachweis • vollständige Dateiliste • Fehlerprotokoll." />
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="2" x:Name="SummaryStatusText" Margin="0,16,0,0" Text="Noch kein Scan durchgeführt." TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Ordner">
                    <DataGrid x:Name="FoldersGrid" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                            <DataGridTextColumn Header="Parent" Binding="{Binding ParentId}" Width="80" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70" />
                            <DataGridTextColumn Header="Ordner" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="Relativer Pfad" Binding="{Binding RelativePath}" Width="2*" />
                            <DataGridTextColumn Header="Dateien direkt" Binding="{Binding DirectFileCount}" Width="105" />
                            <DataGridTextColumn Header="Dateien gesamt" Binding="{Binding RecursiveFileCount}" Width="110" />
                            <DataGridTextColumn Header="Prüffälle" Binding="{Binding OlderThanCutoffFileCount}" Width="100" />
                            <DataGridTextColumn Header="Größe gesamt (Bytes)" Binding="{Binding RecursiveSizeBytes}" Width="135" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Dateien">
                    <DataGrid x:Name="FilesGrid" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr." Binding="{Binding Sequence}" Width="80" />
                            <DataGridTextColumn Header="Level" Binding="{Binding FolderLevel}" Width="65" />
                            <DataGridTextColumn Header="Dateiname" Binding="{Binding Name}" Width="240" />
                            <DataGridTextColumn Header="Erw." Binding="{Binding Extension}" Width="70" />
                            <DataGridTextColumn Header="Relativer Pfad" Binding="{Binding RelativePath}" Width="2*" />
                            <DataGridTextColumn Header="Bytes" Binding="{Binding SizeBytes}" Width="110" />
                            <DataGridTextColumn Header="Erstellt" Binding="{Binding CreationTime}" Width="145" />
                            <DataGridTextColumn Header="Geändert" Binding="{Binding LastWriteTime}" Width="145" />
                            <DataGridTextColumn Header="Referenzdatum" Binding="{Binding ReferenceDate}" Width="145" />
                            <DataGridCheckBoxColumn Header="Älter als Stichtag" Binding="{Binding OlderThanCutoff}" Width="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Fehler / nicht lesbar">
                    <DataGrid x:Name="ErrorsGrid" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="145" />
                            <DataGridTextColumn Header="Vorgang" Binding="{Binding Operation}" Width="180" />
                            <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="2*" />
                            <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="4" Background="#E9EEF2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <TextBlock x:Name="StatusText" Text="Bereit." VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
